generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seller {
  id               String        @id @default(cuid())
  sellerId         String        @unique @map("seller_id")
  name             String
  apiKeyEncrypted  String        @map("api_key_encrypted")
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  events           Event[]
  transactions     Transaction[]

  @@map("sellers")
}

model Event {
  id              String        @id @default(cuid())
  eventId         String        @unique @map("event_id")
  sellerId        String        @map("seller_id")
  sellerRefId     String?
  name            String
  start           DateTime?
  end             DateTime?
  currency        String?
  saleStatus      String?       @map("sale_status")
  rawEventJson    Json?         @map("raw_event_json")
  lastSyncedAt    DateTime?     @map("last_synced_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  seller          Seller?       @relation(fields: [sellerRefId], references: [id])
  accessLinks     EventAccess[]
  transactions    Transaction[]
  syncState       SyncState?

  @@index([sellerId])
  @@map("events")
}

model EventAccess {
  id             String    @id @default(cuid())
  eventId        String    @map("event_id")
  accessToken    String    @unique @map("access_token")
  organizerName  String?   @map("organizer_name")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  lastViewedAt   DateTime? @map("last_viewed_at")
  event          Event     @relation(fields: [eventId], references: [eventId])

  @@index([eventId, active])
  @@map("event_access")
}

model Transaction {
  id                 String    @id @default(cuid())
  transactionId      String    @unique @map("transaction_id")
  eventId            String    @map("event_id")
  sellerId           String    @map("seller_id")
  sellerRefId        String?
  createdAt          DateTime? @map("created_at")
  updatedAt          DateTime? @map("updated_at")
  currency           String?
  regularPrice       Decimal?  @db.Decimal(12, 2) @map("regular_price")
  realPrice          Decimal?  @db.Decimal(12, 2) @map("real_price")
  paymentCharge      Decimal?  @db.Decimal(12, 2) @map("payment_charge")
  innerCharge        Decimal?  @db.Decimal(12, 2) @map("inner_charge")
  outerCharge        Decimal?  @db.Decimal(12, 2) @map("outer_charge")
  email              String?
  status             String?
  rawTransactionJson Json?     @map("raw_transaction_json")
  importedAt         DateTime  @default(now()) @map("imported_at")
  event              Event     @relation(fields: [eventId], references: [eventId])
  seller             Seller?   @relation(fields: [sellerRefId], references: [id])

  @@index([eventId, createdAt])
  @@index([eventId, updatedAt])
  @@map("transactions")
}

model SyncState {
  id                     String    @id @default(cuid())
  eventId                String    @unique @map("event_id")
  lastTransactionsSyncAt DateTime? @map("last_transactions_sync_at")
  lastWebhookAt          DateTime? @map("last_webhook_at")
  syncStatus             String?   @map("sync_status")
  lastError              String?   @map("last_error")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  event                  Event     @relation(fields: [eventId], references: [eventId])

  @@map("sync_state")
}
